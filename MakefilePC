CC = g++ -D_BSD_SOURCE -DSUPPORT_FILEFORMAT_PNG -DSUPPORT_FILEFORMAT_BMP -DSUPPORT_FILEFORMAT_JPG -DSUPPORT_DEFAULT_FONT -DSUPPORT_MODULE_RTEXT
cflags = -std=c++20 -O0 -g -ggdb -Wall -Wno-write-strings -Wno-narrowing
cflags += -Ivendor/raylib/src -Iinclude -Iinclude/menu_shapes -Iinclude/cachebuilder -Ivendor/zip/src -Iinclude/sound -I/usr/x86_64-w64-mingw32/include/SDL2 -I/usr/include/SDL2 -D_REENTRANT -D_FILE_OFFSET_BITS=64
ldflags += -lstdc++ -Lvendor/raylib/src -lraylib -Lvendor/zip/build -lzip -lpthread -ldl -lSDL2main -lSDL2 -lpthread 
name = osus 


sources = $(shell find src -name "*.cpp" -not -path "src/3ds/*" -not -path "src/external/*")
objects = $(patsubst src/%.cpp, object/%.o, $(sources))
deps = $(objects:.o=.d)

-include $(deps)
.PHONY: all clean

all: files deps $(name)

files:
	mkdir -p bin object
	@for dir in $(sort $(dir $(sources))); do \
		mkdir -p $${dir/src/object}; \
	done

deps:
	cd vendor/raylib/src/ && $(MAKE)
	cd vendor/zip && mkdir -p build && cd build && cmake .. -DCMAKE_DISABLE_TESTING=1 && make -j12

run: $(name)
	mkdir -p beatmaps
	bin/$(name) 

$(name): $(objects)
	$(CC) -o bin/$(name) $^ $(ldflags)

object/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CC) -MMD -o $@ -c $< $(cflags)

clean:
	rm -rf vendor/raylib/src/*.o vendor/raylib/src/libraylib.a bin/$(name) $(objects) object/*.d vendor/zip/build SDL_mixer/build vendor/raylib/src/external/glfw/build